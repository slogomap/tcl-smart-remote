<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tcl.smartremote">

    <!-- ===================================================================
         ANDROID PERMISSIONS EXPLANATION (SECTION 13 COMPLIANCE)
         =================================================================== -->

    <!-- Required for establishing local TCP/TLS sockets to the TCL TV (port 6467)
         and communicating with the local backend REST service. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required to check whether the phone has an active local network connection
         and identify whether Wi-Fi or Ethernet is active before sending commands. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Required to inspect Wi-Fi state, link speed, and verify local subnet IP
         address for subnet discovery and local-first routing. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Required for Android TV discovery via mDNS / Zeroconf (Multicast DNS on 224.0.0.251:5353).
         Without this permission, Android blocks incoming multicast discovery packets. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Required for tactile haptic feedback when remote buttons, D-pad, and
         volume rockers are pressed. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Required to keep the CPU awake momentarily during Wake-on-LAN magic packet
         transmission and during active pairing negotiations. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Android 13+ (API level 33): Allows local Wi-Fi discovery without requiring
         coarse or fine GPS location access, preserving user privacy. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <application
        android:label="TCL SMART REMOTE"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
